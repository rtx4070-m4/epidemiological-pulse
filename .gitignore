# ─────────────────────────────────────────────────────────────────
# Epidemiological Pulse – .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.installed.cfg
pip-selfcheck.json
MANIFEST

# ── Virtual environments ──────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# ── Jupyter ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Pytest / Coverage ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ── Type checkers ─────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ── IDE / Editor ──────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.spyderproject.cfg
.spyproject/
.ropeproject/

# ── OS files ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Project-specific: sensitive / large files ─────────────────────

# API keys (NEVER commit real keys)
config/api_keys.yaml
!config/api_keys.yaml.example

# Generated data (synthetic CSVs can be re-generated)
data/synthetic/
data/raw/
data/processed/
data/interim/

# Trained model artifacts (can be re-trained)
outputs/models/*.pkl
outputs/models/*.pt
outputs/models/*.pth
outputs/models/*.joblib
outputs/models/*.json

# GeoJSON exports
outputs/geojson/*.geojson

# Reports
outputs/reports/*.csv
outputs/reports/*.html

# Log files
logs/*.log
logs/*.log.*

# Docker
.dockerignore
docker-compose.override.yml

# Profiling
*.prof
*.lprof

# Misc
*.bak
*.tmp
*.temp
.cache/
